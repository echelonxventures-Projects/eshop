NODE_ENV=development
PORT=8899
STORAGE_ADAPTER=postgres
# Set STORAGE_ADAPTER_MODULE to an installed or workspace adapter implementing server/storage/contract.js.
STORAGE_ADAPTER_MODULE=
# Used by document/keyvalue/graph/search/vector adapters. Defaults to .marketly-storage/<model>-storage.json.
STORAGE_FILE_PATH=
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
METRICS_TOKEN=
TRUST_PROXY=false
DATABASE_URL=postgres://marketly:marketly@127.0.0.1:55433/marketly
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
PROVIDER_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30
CORS_ORIGIN=http://localhost:5173
DB_POOL_MAX=20
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=commerce
OUTBOX_POLL_MS=1000
ADAPTER_ROOT=server/adapters
CONFIGURATION_MANIFEST=platform-config.json
